<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen: Sign Up (Join FreelancePro)
    Palette:
        Background   #FAF9F0  (warm cream)
        Primary Text #2D0A13  (deep maroon-black)
        Accent/Brand #4A0E1C  (maroon)
        Hint/Label   #C9A24A  (gold)
        Muted/Divider#BCB095  (tan)
        Field/Card BG#FFFFFF  (pure white, Google-style flat surface)
        Border       #E4DFC9  (hairline)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSignUp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F0"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/llRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">


        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="100dp"
            android:layout_height="74dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />


        <!-- ==================== TITLE / SUBTITLE ==================== -->

        <TextView
            android:id="@+id/tvSignUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="Join FreelancePro"
            android:textColor="#2D0A13"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:text="Create your account to start managing projects."
            android:textColor="#4A0E1C"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- ==================== FULL NAME ==================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Full Name"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#4A0E1C"
            app:boxStrokeErrorColor="#B3261E"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:errorEnabled="true"
            app:hintTextColor="#C9A24A"
            app:startIconDrawable="@drawable/ic_outline_person"
            app:startIconTint="#4A0E1C">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:textColor="#2D0A13"
                android:textColorHint="#C9A24A"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================== EMAIL ==================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Email Address"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#4A0E1C"
            app:boxStrokeErrorColor="#B3261E"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:errorEnabled="true"
            app:hintTextColor="#C9A24A"
            app:startIconDrawable="@drawable/ic_outline_email"
            app:startIconTint="#4A0E1C">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="#2D0A13"
                android:textColorHint="#C9A24A"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================== PASSWORD ==================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Password"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#4A0E1C"
            app:boxStrokeErrorColor="#B3261E"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#4A0E1C"
            app:errorEnabled="true"
            app:hintTextColor="#C9A24A"
            app:startIconDrawable="@drawable/ic_outline_password"
            app:startIconTint="#4A0E1C">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="#2D0A13"
                android:textColorHint="#C9A24A"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvPasswordHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:text="Use at least 8 characters, with a number and a symbol."
            android:textColor="#8A7F63"
            android:textSize="11sp" />

        <!-- ==================== CREATE ACCOUNT ==================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#4A0E1C"
            android:elevation="0dp"
            android:letterSpacing="0.01"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:rippleColor="#8A5A66" />

        <!-- ==================== TERMS & CONDITIONS ==================== -->

        <LinearLayout
            android:id="@+id/llTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#4A0E1C" />

            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="I agree to the Terms &amp; Conditions and Privacy Policy"
                android:textColor="#4A0E1C"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ==================== DIVIDER ==================== -->

        <LinearLayout
            android:id="@+id/llDividerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#DCD5B8" />

            <TextView
                android:id="@+id/tvDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:letterSpacing="0.1"
                android:text="OR CONTINUE WITH"
                android:textColor="#BCB095"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#DCD5B8" />

        </LinearLayout>

        <!-- ==================== SOCIAL BUTTONS ==================== -->

        <LinearLayout
            android:id="@+id/llSocialButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- GOOGLE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="0dp"
                android:text="Sign up with Google"
                android:textAllCaps="false"
                android:textColor="#2D0A13"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                app:rippleColor="#F1EEDD"
                app:strokeColor="#2D0A13"
                app:strokeWidth="1.5dp" />

            <!-- LINKEDIN -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkedIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="0dp"
                android:text="Sign up with LinkedIn"
                android:textAllCaps="false"
                android:textColor="#2D0A13"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_linkedin"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                app:rippleColor="#F1EEDD"
                app:strokeColor="#2D0A13"
                app:strokeWidth="1.5dp" />

        </LinearLayout>

        <!-- ==================== LOGIN REDIRECT ==================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLoginRedirect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#E4DFC9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/llLoginRedirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvLoginCta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log In"
                    android:textColor="#2D0A13"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoginSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Already have an account?"
                    android:textColor="#4A0E1C"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
