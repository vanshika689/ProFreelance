<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/projectCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2D5D8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ========================================= -->
        <!-- TOP PROJECT HEADER -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Project Icon -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#FAF2F3"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E8D8DB"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivProjectIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Project"
                    android:src="@drawable/ic_folder"
                    app:tint="#4A0E1C" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Project title -->

            <TextView
                android:id="@+id/tvProjectName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="E-Commerce Android App"
                android:textColor="#2D0A13"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- More icon -->



        </LinearLayout>

        <!-- ========================================= -->
        <!-- CLIENT -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:text="CLIENT"
                android:textColor="#806A70"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:text="Nexus Retail"
                android:textColor="#2D0A13"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="#EEE5E7" />

        <!-- ========================================= -->
        <!-- DATE -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:text="DATE"
                android:textColor="#806A70"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProjectDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Oct 12, 2023"
                android:textColor="#2D0A13"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="#EEE5E7" />

        <!-- ========================================= -->
        <!-- STATUS -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:text="STATUS"
                android:textColor="#806A70"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Status indicator -->

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/tvProjectStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.03"
                android:text="NOT STARTED"
                android:textColor="#B08222"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!-- START PROJECT BUTTON -->
        <!-- ========================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartProject"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#4A0E1C"
            android:elevation="0dp"
            android:text="Start Project"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="23dp"
            app:rippleColor="#8A5A66" />

        <!-- ========================================= -->
        <!-- MILESTONE PROGRESS -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/projectProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Progress header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMilestoneProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3 of 6 milestones"
                    android:textColor="#4A0E1C"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#4A0E1C"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Progress bar -->

            <ProgressBar
                android:id="@+id/projectProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="9dp"
                android:max="100"
                android:progress="50"
                android:progressTint="#4A0E1C"
                android:secondaryProgressTint="#E8DDE0" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>